# Configuración de Firebase para 3D Print Studio
# Reemplaza con los valores de la consola de Firebase:
# Configuración del proyecto -> General -> Tus aplicaciones -> Configuración SDK

VITE_FIREBASE_PROJECT_ID=dprintstudio-d37f1
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=dprintstudio-d37f1.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=dprintstudio-d37f1.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
