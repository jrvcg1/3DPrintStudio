rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permiso de lectura pública para productos, categorías, faqs y reviews
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || true; // Para pruebas locales iniciales
    }
    
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /reviews/{document=**} {
      allow read: if true;
      allow write: if true; // Permitir enviar opiniones
    }

    match /orders/{document=**} {
      allow read, write: if true;
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
  }
}
